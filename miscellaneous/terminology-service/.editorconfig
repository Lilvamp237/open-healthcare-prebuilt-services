root = true

# Ballerina source files must be UTF-8 without a BOM. A BOM breaks the
# Ballerina compiler (it reads the marker as a stray token before the first
# import). "charset = utf-8" means no BOM; "utf-8-bom" would add one.
[*.bal]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
